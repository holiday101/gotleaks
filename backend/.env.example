# Copy to .env and fill in real values. .env is gitignored -- never commit it.

# Same Neptune 360 SDK credentials as the original Neptune project.
NEPTUNE_API_KEY=
NEPTUNE_CLIENT_ID=
NEPTUNE_CLIENT_SECRET=
NEPTUNE_SITE_ID=
NEPTUNE_HOST=aygpg477xh.execute-api.us-west-2.amazonaws.com
NEPTUNE_DAILY_CALL_BUDGET=480
NEPTUNE_ALLOW_SYNC=false

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Points at the SAME live database the Neptune checkout and production
# server use -- never copy neptune.db (it's multiple GB and would
# immediately go stale). On this Mac, that's the Neptune checkout's copy:
DB_PATH=/Users/jaredholland/Neptune/data/neptune.db

# Comma-separated frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000
