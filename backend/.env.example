# Copy to .env and fill in real values. .env is gitignored -- never commit it.

# Same Neptune 360 SDK credentials as the original Neptune project.
NEPTUNE_API_KEY=
NEPTUNE_CLIENT_ID=
NEPTUNE_CLIENT_SECRET=
NEPTUNE_SITE_ID=
NEPTUNE_HOST=aygpg477xh.execute-api.us-west-2.amazonaws.com
NEPTUNE_DAILY_CALL_BUDGET=480
NEPTUNE_ALLOW_SYNC=false

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Points at the SAME live database the Neptune checkout and production
# server use -- never copy neptune.db (it's multiple GB and would
# immediately go stale). On this Mac, that's the Neptune checkout's copy:
DB_PATH=/Users/jaredholland/Neptune/data/neptune.db

# Comma-separated frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# --- Auth (new in GotLeaks, mirrors Neptune's NEPTUNE_PUBLIC_MODE) ---------
# false (default) = no login prompt, everyone gets full "global" access --
# for local/private use, same as the Streamlit app. Set true for a public
# deployment (e.g. the EC2 server) to require per-user email/password login,
# gated by role: viewer < admin < global (same three-tier ladder as before).
NEPTUNE_PUBLIC_MODE=false

# Signs the session cookie when NEPTUNE_PUBLIC_MODE=true. Required in that
# case -- generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Set true only when served over HTTPS (adds the cookie's Secure flag).
# Leave false for local http://localhost dev.
COOKIE_SECURE=false

# One-time bootstrap: if NO global account exists yet, the first write
# connection creates one from these (then never touches them again -- a
# password changed later through the app won't get reset by these).
NEPTUNE_SEED_GLOBAL_EMAIL=
NEPTUNE_SEED_GLOBAL_PASSWORD=

# --- Resident notification emails ------------------------------------------
# Get an API key from https://resend.com after verifying a sending domain
# there (add the SPF/DKIM records it gives you to that domain's DNS).
RESEND_API_KEY=
# Must be an address on a domain verified in Resend.
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Providence City Utility Billing
# Used as the "Sincerely, ___" signer merged into the template -- can differ
# from EMAIL_FROM_NAME (e.g. a person's name vs. the department name).
EMAIL_SENDER_DISPLAY_NAME=Providence City Utility Billing

# Where the email template + send log are stored -- deliberately NOT
# neptune.db (see notifications_db.py). Defaults to backend/data/gotleaks.db.
NOTIFICATIONS_DB_PATH=
