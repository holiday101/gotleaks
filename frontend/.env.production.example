# Copy to .env.production on the server (gitignored -- never commit it).
# Loaded at BUILD time (basePath) and at RUN time (the rest) by
# gotleaks-frontend.service -- see deploy/gotleaks-frontend.service.

# Keeps the app at membergolfonline.com/water/ (same URL the Streamlit app
# used) instead of introducing a new subdomain. Must be set before
# `npm run build` -- basePath is baked into the build, not read at runtime.
NEXT_BASE_PATH=/water

# Browser-side fetch calls (client components) go through nginx at this
# same-origin path prefix -- see deploy/nginx-water-location.conf, which
# maps /water/api/ -> the backend's /api/ routes.
NEXT_PUBLIC_API_URL=/water

# Server-side (SSR) fetch calls from the Next.js process go straight to the
# backend process on localhost, bypassing nginx entirely.
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
